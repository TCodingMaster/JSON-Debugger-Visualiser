//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// FVG Pro Setups — setup finder for MNQ 15m (break of structure + FVG)
//
// Same setup rules as pine/fvg_pro_strategy.pine and lab/fvg_pro.py:
//   • BOS: a candle closes beyond the last confirmed swing (3 bars each side).
//   • FVG: earliest gap (>= 0.15 × ATR14) from 3 bars before to 3 after the BOS.
//   • Entry: limit at the gap's near edge, valid 20 bars, cancelled if a candle
//     closes through the gap. Stop: beyond the move's extreme + 2 ticks.
//   • Target: 1.5R by default (input). Sessions: Asia 20:00–24:00 and London
//     02:00–05:00 New York time. Max 2 trades per Globex day, flat by 15:55.
//
// Backtest (Python lab, Yahoo data Aug 6 – Oct 15 2026, MNQ 15m, 1.5R):
// 34 trades, 67.6 % win rate (95 % range 51–81 %), +0.68R per trade.
// All markets and timeframes together: 484 trades, 49.8 %, +0.22R.
// Small sample: treat the on-chart stats as a guide, not a promise.
//
// On the chart: grey band = setup session; ▲/▼ = BOS; box = the FVG;
// blue line = limit entry, red = stop, green = target. Each setup is
// played out virtually (fill, stop or target) and counted in the table.
// Alerts: new setup, entry filled, target hit, stop hit.
// Not financial advice.
// ─────────────────────────────────────────────────────────────────────────────
indicator("FVG Pro Setups", overlay = true, max_boxes_count = 400, max_lines_count = 400,
     max_labels_count = 400, max_bars_back = 300)

G1 = "Setup"
pivotLen  = input.int(3, "Pivot length (swing confirmation bars)", minval = 1, group = G1)
minFvgAtr = input.float(0.15, "Min FVG size × ATR(14)", minval = 0, step = 0.05, group = G1)
fvgBefore = input.int(3, "FVG up to N bars before the BOS", minval = 0, maxval = 10, group = G1)
fvgAfter  = input.int(3, "…and up to N bars after", minval = 0, maxval = 10, group = G1)
entryMode = input.string("Edge", "Entry in the FVG", options = ["Edge", "CE (50%)"], group = G1)

G2 = "Risk"
rr         = input.float(1.5, "Reward : risk", minval = 0.5, step = 0.25, group = G2)
bufTicks   = input.int(2, "Stop buffer (ticks)", minval = 0, group = G2)
stopLook   = input.int(10, "Stop: extreme from N bars before the BOS", minval = 1, maxval = 50, group = G2)
expiryBars = input.int(20, "Cancel unfilled setup after N bars", minval = 1, group = G2)
minRiskTk  = input.int(4, "Skip if stop closer than N ticks", minval = 0, group = G2)
maxRiskAtr = input.float(3.0, "Skip if stop wider than N × ATR", minval = 0.5, group = G2)
maxTrades  = input.int(2, "Max trades per Globex day", minval = 1, group = G2)
pointValue = input.float(0, "$ per point per contract (0 = auto: MNQ 2, MGC 10)", group = G2)
contracts  = input.int(0, "Contracts (0 = auto: MNQ 2, MGC 1)", group = G2)

G3 = "Sessions (New York time, HHMM-HHMM)"
useS1  = input.bool(true, "Asia", inline = "s1", group = G3)
sess1  = input.string("2000-0000", "", inline = "s1", group = G3)
useS2  = input.bool(true, "London", inline = "s2", group = G3)
sess2  = input.string("0200-0500", "", inline = "s2", group = G3)
useS3  = input.bool(false, "NY AM", inline = "s3", group = G3)
sess3  = input.string("0830-1100", "", inline = "s3", group = G3)
flatHM = input.string("1555", "Flat by (HHMM)", group = G3)
useTrend = input.bool(false, "Only with the 1-hour trend", group = G3)

G4 = "Display"
showSess  = input.bool(true, "Shade setup sessions", group = G4)
showBos   = input.bool(true, "Mark BOS", group = G4)
showTable = input.bool(true, "Stats table", group = G4)
goalWr    = input.float(60.0, "Goal: win rate %", group = G4)
colLong   = input.color(color.new(color.teal, 0), "Long colour", group = G4)
colShort  = input.color(color.new(color.red, 0), "Short colour", group = G4)

// ── Helpers ──────────────────────────────────────────────────────────────────
TZ = "America/New_York"
minuteOfDay(t) => hour(t, TZ) * 60 + minute(t, TZ)
hm(string s, int at) => int(str.tonumber(str.substring(s, at, at + 2))) * 60 + int(str.tonumber(str.substring(s, at + 2, at + 4)))
inWindow(string s, int m) =>
    int a = hm(s, 0)
    int b = hm(s, 5)
    b := b == 0 ? 1440 : b
    a <= b ? (m >= a and m < b) : (m >= a or m < b)
gday(t) =>
    int t6 = t + 6 * 3600 * 1000
    year(t6, TZ) * 10000 + month(t6, TZ) * 100 + dayofmonth(t6, TZ)
flatMin = hm(flatHM, 0)
afterFlat(int m) => m >= flatMin and m < 18 * 60
modOpen = minuteOfDay(time)
inSess  = (useS1 and inWindow(sess1, modOpen)) or (useS2 and inWindow(sess2, modOpen)) or (useS3 and inWindow(sess3, modOpen))
tick = syminfo.mintick
buf  = bufTicks * tick
atr  = ta.atr(14)
pv   = pointValue > 0 ? pointValue : syminfo.root == "MGC" ? 10.0 : syminfo.root == "MNQ" ? 2.0 : syminfo.pointvalue
qty  = contracts > 0 ? contracts : syminfo.root == "MGC" ? 1 : 2
barsPerHour = math.max(1, int(60 / math.max(1, timeframe.multiplier)))
emaH  = ta.ema(close, 20 * barsPerHour)
trend = math.sign(emaH - emaH[barsPerHour])

bgcolor(showSess and inSess ? color.new(color.gray, 93) : na, title = "Setup session")

// ── Structure ────────────────────────────────────────────────────────────────
hiR = ta.highest(high, pivotLen)
loR = ta.lowest(low, pivotLen)
var float lastSH = na
var float lastSL = na
var float usedUp = na
var float usedDn = na
if bar_index >= 2 * pivotLen
    if high[pivotLen] > hiR[pivotLen + 1] and high[pivotLen] >= hiR
        lastSH := high[pivotLen]
    if low[pivotLen] < loR[pivotLen + 1] and low[pivotLen] <= loR
        lastSL := low[pivotLen]
bosUp = not na(lastSH) and close > lastSH and (na(usedUp) or lastSH != usedUp)
bosDn = not na(lastSL) and close < lastSL and (na(usedDn) or lastSL != usedDn)
if bosUp
    usedUp := lastSH
if bosDn
    usedDn := lastSL
plotshape(showBos and bosUp, "BOS up", shape.triangleup, location.belowbar, color.new(colLong, 40), size = size.tiny)
plotshape(showBos and bosDn, "BOS down", shape.triangledown, location.abovebar, color.new(colShort, 40), size = size.tiny)

gapAt(int k, int side) =>
    bool ok = false
    float bot = na
    float top = na
    if side > 0 and low[k] > high[k + 2] and (low[k] - high[k + 2]) >= minFvgAtr * atr[k]
        ok := true
        bot := high[k + 2]
        top := low[k]
    if side < 0 and high[k] < low[k + 2] and (low[k + 2] - high[k]) >= minFvgAtr * atr[k]
        ok := true
        bot := high[k]
        top := low[k + 2]
    [ok, bot, top]
lowestBack(int a, int b) =>
    float v = low[a]
    for j = a to b
        v := math.min(v, low[j])
    v
highestBack(int a, int b) =>
    float v = high[a]
    for j = a to b
        v := math.max(v, high[j])
    v

var array<int> waitBar  = array.new<int>()
var array<int> waitSide = array.new<int>()
setSide = array.new<int>()
setBot  = array.new<float>()
setTop  = array.new<float>()
setStop = array.new<float>()
setGapBar = array.new<int>()
addSetup(int side, int bos, int k, float bot, float top) =>
    int a = bar_index - k
    int b = math.min(bar_index - bos + stopLook, bar_index)
    float st = side > 0 ? lowestBack(a, b) - buf : highestBack(a, b) + buf
    array.push(setSide, side)
    array.push(setBot, bot)
    array.push(setTop, top)
    array.push(setStop, st)
    array.push(setGapBar, k)
for s = 0 to 1
    int side = s == 0 ? 1 : -1
    bool ev = side > 0 ? bosUp : bosDn
    if ev
        bool got = false
        int first = math.min(fvgBefore, bar_index - 2)
        for off = first to 0
            if not got
                [ok, bot, top] = gapAt(off, side)
                if ok
                    got := true
                    addSetup(side, bar_index, bar_index - off, bot, top)
        if not got
            array.push(waitBar, bar_index)
            array.push(waitSide, side)
if array.size(waitBar) > 0
    keepBar  = array.new<int>()
    keepSide = array.new<int>()
    for w = 0 to array.size(waitBar) - 1
        int wb = array.get(waitBar, w)
        int ws = array.get(waitSide, w)
        if wb == bar_index
            array.push(keepBar, wb)
            array.push(keepSide, ws)
        else
            [ok, bot, top] = gapAt(0, ws)
            if ok
                addSetup(ws, wb, bar_index, bot, top)
            else if bar_index - wb < fvgAfter
                array.push(keepBar, wb)
                array.push(keepSide, ws)
    waitBar := keepBar
    waitSide := keepSide

// ── Virtual trade tracking (same order as the backtest engine) ───────────────
var int   dayKey = na
var int   dayTrades = 0
var int   pSide = 0          // pending setup
var float pEntry = na
var float pStop = na
var float pTgt = na
var float pInval = na
var int   pBar = na
var line  lE = na
var line  lS = na
var line  lT = na
var int   aSide = 0          // active (filled) trade
var float aEntry = na
var float aStop = na
var float aTgt = na
var int   aBar = na
var int   nSetups = 0
var int   nWins = 0
var int   nLoss = 0
var float sumR = 0.0
var float sumUsd = 0.0

curDay = gday(time)
newDay = na(dayKey) or curDay != dayKey
if newDay
    dayKey := curDay
    dayTrades := 0

closeTrade(float px, string why) =>
    float r = (px - aEntry) * aSide / ((aEntry - aStop) * aSide)
    float usd = (px - aEntry) * aSide * pv * qty
    label.new(bar_index, aSide > 0 ? high : low, (r > 0 ? "TP " : why + " ") + str.tostring(r, "+#.##;-#.##") + "R",
         color = r > 0 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white,
         style = aSide > 0 ? label.style_label_down : label.style_label_up, size = size.small)
    [r, usd]

// 1) manage the active trade on this bar
if aSide != 0
    float exitPx = na
    string why = ""
    if newDay or afterFlat(modOpen)
        exitPx := open
        why := "EOD"
    else
        bool gapStop = aSide > 0 ? open <= aStop : open >= aStop
        bool hitStop = aSide > 0 ? low <= aStop : high >= aStop
        bool hitTgt  = aSide > 0 ? high >= aTgt : low <= aTgt
        bool tgtFirst = aSide > 0 ? (high - open < open - low) : (open - low < high - open)
        if gapStop
            exitPx := open
            why := "SL"
        else if hitStop and hitTgt and tgtFirst
            exitPx := aTgt
            why := "TP"
        else if hitStop
            exitPx := aStop
            why := "SL"
        else if hitTgt
            exitPx := aTgt
            why := "TP"
    if not na(exitPx)
        [r, usd] = closeTrade(exitPx, why)
        if r > 0
            nWins += 1
        else
            nLoss += 1
        sumR += r
        sumUsd += usd
        alert(syminfo.ticker + " FVG Pro: " + why + " " + str.tostring(r, "+#.##;-#.##") + "R", alert.freq_once_per_bar_close)
        aSide := 0

// 2) work the pending setup (only when flat)
if pSide != 0 and aSide == 0
    if bar_index - pBar > expiryBars or newDay or afterFlat(modOpen) or dayTrades >= maxTrades
        pSide := 0
    else
        bool filled = pSide > 0 ? low <= pEntry : high >= pEntry
        if filled
            float fill = pSide > 0 ? math.min(open, pEntry) : math.max(open, pEntry)
            aSide := pSide
            aEntry := fill
            aStop := pStop
            aTgt := fill + pSide * rr * (fill - pStop) * pSide
            aBar := bar_index
            dayTrades += 1
            pSide := 0
            alert(syminfo.ticker + " FVG Pro: " + (aSide > 0 ? "LONG" : "SHORT") + " filled @ " + str.tostring(aEntry), alert.freq_once_per_bar_close)
            // stop or target already inside the fill bar
            bool hitStop = aSide > 0 ? low <= aStop : high >= aStop
            bool tgtClose = aSide > 0 ? close >= aTgt : close <= aTgt
            if hitStop or tgtClose
                float px = hitStop ? aStop : aTgt
                [r, usd] = closeTrade(px, hitStop ? "SL" : "TP")
                if r > 0
                    nWins += 1
                else
                    nLoss += 1
                sumR += r
                sumUsd += usd
                aSide := 0
        else if (pSide > 0 and close < pInval) or (pSide < 0 and close > pInval)
            pSide := 0

// 3) new setups decided on this bar's close (newest replaces an older pending one)
nSet = array.size(setSide)
if nSet > 0 and aSide == 0 and dayTrades < maxTrades and not afterFlat(modOpen) and inSess
    for i = 0 to nSet - 1
        int side = array.get(setSide, i)
        float bot = array.get(setBot, i)
        float top = array.get(setTop, i)
        float st = array.get(setStop, i)
        float entry = entryMode == "Edge" ? (side > 0 ? top : bot) : math.round_to_mintick((bot + top) / 2)
        float risk = (entry - st) * side
        if (not useTrend or trend * side > 0) and risk >= minRiskTk * tick and (atr <= 0 or risk <= maxRiskAtr * atr)
            float tgt = entry + side * rr * risk
            pSide := side
            pEntry := entry
            pStop := st
            pTgt := tgt
            pInval := side > 0 ? bot : top
            pBar := bar_index
            nSetups += 1
            color col = side > 0 ? colLong : colShort
            int gb = array.get(setGapBar, i)
            box.new(gb - 2, top, bar_index + expiryBars, bot, border_color = color.new(col, 50), bgcolor = color.new(col, 85),
                 text = "FVG", text_size = size.tiny, text_color = color.new(col, 20), text_halign = text.align_right)
            line.new(bar_index, entry, bar_index + expiryBars, entry, color = color.blue, width = 2)
            line.new(bar_index, st, bar_index + expiryBars, st, color = color.red)
            line.new(bar_index, tgt, bar_index + expiryBars, tgt, color = color.green, style = line.style_dashed)
            label.new(bar_index, side > 0 ? low : high, (side > 0 ? "LONG " : "SHORT ") + "setup\nE " + str.tostring(entry) +
                 "\nSL " + str.tostring(st) + "\nTP " + str.tostring(tgt, format.mintick),
                 color = color.new(col, 20), textcolor = color.white, size = size.small,
                 style = side > 0 ? label.style_label_up : label.style_label_down)
            alert(syminfo.ticker + " FVG Pro: " + (side > 0 ? "LONG" : "SHORT") + " setup — limit " + str.tostring(entry) +
                 ", SL " + str.tostring(st) + ", TP " + str.tostring(tgt, format.mintick), alert.freq_once_per_bar_close)

// ── Stats table ──────────────────────────────────────────────────────────────
if showTable and barstate.islast
    var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 15), border_width = 1)
    int n = nWins + nLoss
    float wr = n > 0 ? 100.0 * nWins / n : 0.0
    table.cell(tb, 0, 0, "FVG Pro Setups", text_color = color.white)
    table.cell(tb, 1, 0, syminfo.root + " " + timeframe.period + " · " + str.tostring(rr, "#.##") + "R", text_color = color.white)
    table.cell(tb, 0, 1, "Setups / trades", text_color = color.white)
    table.cell(tb, 1, 1, str.tostring(nSetups) + " / " + str.tostring(n), text_color = color.white)
    table.cell(tb, 0, 2, "Win rate", text_color = color.white)
    table.cell(tb, 1, 2, str.tostring(wr, "#.0") + "% (goal " + str.tostring(goalWr, "#") + "%)", text_color = wr >= goalWr ? color.lime : color.orange)
    table.cell(tb, 0, 3, "Avg R per trade", text_color = color.white)
    table.cell(tb, 1, 3, n > 0 ? str.tostring(sumR / n, "+#.##;-#.##") + "R" : "–", text_color = sumR >= 0 ? color.lime : color.red)
    table.cell(tb, 0, 4, "Net (gross, no costs)", text_color = color.white)
    table.cell(tb, 1, 4, "$" + str.tostring(sumUsd, "#,###"), text_color = sumUsd >= 0 ? color.lime : color.red)
    table.cell(tb, 0, 5, "Breakeven WR at " + str.tostring(rr, "#.##") + "R", text_color = color.white)
    table.cell(tb, 1, 5, str.tostring(100.0 / (1 + rr), "#.0") + "%", text_color = color.white)
    table.cell(tb, 0, 6, "Pending / open", text_color = color.white)
    table.cell(tb, 1, 6, pSide != 0 ? (pSide > 0 ? "long limit " : "short limit ") + str.tostring(pEntry) : aSide != 0 ? (aSide > 0 ? "long open" : "short open") : "—", text_color = color.white)
